# MineGuard-AI Environment Configuration
# Demonstration Configuration - NOT an approved mine safety limit

# Application
APP_NAME=MineGuard-AI
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./data/mineguard.db

# MQTT Broker (Non-blocking fallback enabled if broker unreachable)
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=mineguard-central-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mineguard
MQTT_TLS_ENABLED=false
MQTT_KEEPALIVE=60
MQTT_RECONNECT_MIN_DELAY_S=1.0
MQTT_RECONNECT_MAX_DELAY_S=60.0
GATEWAY_REPLAY_MAX_BATCH_SIZE=2000

# Demonstration Thresholds (SI Units: mm, degrees, m/s^2, mm/hr)
# NOTICE: For demonstration only. Site-specific geotechnical signoff required.
TILT_WARNING_DEG=2.0
TILT_CRITICAL_DEG=5.0
DISPLACEMENT_WARNING_MM=15.0
DISPLACEMENT_CRITICAL_MM=30.0
RATE_WARNING_MM_HR=2.0
RATE_CRITICAL_MM_HR=5.0
ACCEL_WARNING_MM_HR2=0.5
VIBRATION_WARNING_MS2=3.0
VIBRATION_CRITICAL_MS2=8.0
BATTERY_LOW_PCT=20.0
STALE_DATA_TIMEOUT_SEC=120

# Analytics & Machine Learning
ML_ANOMALY_ENABLED=true
ML_CONTAMINATION=0.05
ML_MIN_SAMPLES_TRAIN=30

# Simulator Defaults
SIMULATOR_AUTOSTART=false
SIMULATOR_DEFAULT_INTERVAL_SEC=3.0
SIMULATOR_DEFAULT_NODES=6
SIMULATOR_RANDOM_SEED=42

